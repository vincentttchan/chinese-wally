{
  "id": "zanhua-three-act-entry",
  "version": "0.1.0",
  "date": "2026-10-27",
  "status": "independent-discussion-sample",
  "role": "隨師展卷的學畫人",
  "baseline": "site-2026-10-27-three-act-entry-baseline",
  "scenes": [
    {
      "label": "盛裝一刻",
      "caption": "畫中場景 · 盛裝遊賞",
      "action": "看看這一卷",
      "groups": [
        {
          "kind": "kicker",
          "lines": [
            "盛裝一刻"
          ]
        },
        {
          "lines": [
            "畫中，幾位女子盛裝遊賞。",
            "高髻簪花，長裙曳地。",
            "有人拈花，有人在旁執扇。"
          ]
        },
        {
          "kind": "closing",
          "lines": [
            "她們的手勢與目光，",
            "留下各不相同的片刻。"
          ]
        }
      ]
    },
    {
      "label": "畫中仕女",
      "caption": "簪花仕女圖 · 傳唐代周昉作",
      "action": "隨師展卷",
      "groups": [
        {
          "kind": "kicker",
          "lines": [
            "畫中仕女"
          ]
        },
        {
          "lines": [
            "眼前的《簪花仕女圖》，",
            "傳為唐代畫家周昉所作，",
            "現藏遼寧省博物館。"
          ]
        },
        {
          "kind": "closing",
          "lines": [
            "畫卷留下了她們的樣貌，",
            "畫中卻沒有記下她們的姓名。"
          ]
        }
      ]
    },
    {
      "label": "初學看畫",
      "caption": "你的身份 · 隨師展卷的學畫人",
      "action": "看看她的樣子",
      "groups": [
        {
          "kind": "kicker",
          "lines": [
            "初學看畫"
          ]
        },
        {
          "lines": [
            "你是隨師展卷的學畫人。",
            "師長輕聲囑咐："
          ]
        },
        {
          "kind": "quote",
          "lines": [
            "「先認清這位女子的面孔。",
            "找到她，再循着手勢與目光，",
            "看看她正在做甚麼。」"
          ]
        }
      ]
    }
  ],
