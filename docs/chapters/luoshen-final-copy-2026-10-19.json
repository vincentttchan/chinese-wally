      "kind": "witness",
      "x": 0.5670426065162907,
      "y": 0.16436903499469777,
      "width": 0.008771929824561403,
      "height": 0.2757158006362672,
      "replies": [
        "我的身影出現在雲上。",
        "看看雲氣怎樣圍著身形。",
        "這段畫面充滿神話想像。"
      ],
      "speechType": "遊戲虛構對白"
    },
    {
      "id": "water-attendant",
      "name": "水畔俯身者",
      "kind": "witness",
      "x": 0.5513784461152882,
      "y": 0.7985153764581124,
      "width": 0.010025062656641603,
      "height": 0.32873806998939553,
      "replies": [
        "我在水畔俯下身來。",
        "姿態與站立的人不同。",
        "看看手與水面的距離。"
      ],
      "speechType": "遊戲虛構對白"
    },
    {
      "id": "floating-woman",
      "name": "水上同行神女",
      "kind": "witness",
      "x": 0.5393483709273182,
      "y": 0.49628844114528103,
      "width": 0.014035087719298246,
      "height": 0.38176033934252385,
      "replies": [
        "水上還有隨行的神女。",
        "衣帶在身旁伸展。",
        "主角以外，行列仍在繼續。"
      ],
      "speechType": "遊戲虛構對白"
    }
  ],
  "collections": [
    {
      "id": "dragon",
      "name": "龍形",
      "text": "開首可見單獨的龍形，雲車前又有龍形相連。留意它們的位置：一處伴著神女，一處牽引車駕。"
    },
    {
      "id": "boat",
      "name": "舟船",
      "text": "上層是曹植與同行者，下層是操船的人。沿著上下兩層看，便能分清乘舟尋望與操船的不同角色。"
    },
    {
      "id": "canopy",
      "name": "華蓋",
      "text": "隊伍上方的蓋與長柄，是找華蓋的線索。它在人間隊伍與雲車附近都出現；回看時，比較蓋的輪廓和旁邊的人。"
    },
    {
      "id": "bird",
      "name": "鳥形",
      "text": "開首的鳥在飛，離別處的長頸鳥伴在神女身旁。比較姿態與相伴的人，再讀「翩若驚鴻」的比喻。"
    },
    {
      "id": "ribbon",
      "name": "衣帶",
      "text": "順著衣帶看，長線隨人物回轉而彎曲。比較兩處身影，便能看出姿態的變化；衣帶的方向不等同真實風向。"
    }
  ],
