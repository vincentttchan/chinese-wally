  "chapters": [
    {
      "id": "lantern-festival",
      "title": "宮中鬧元宵",
      "version": "1.1.0",
      "role": "初次隨行的小內侍",
      "fiction": "小內侍身份及對白為遊戲虛構",
      "scenes": [
        {
          "label": "宮中元宵",
          "caption": "明代 · 宮中元宵",
          "action": "看看這一卷",
          "groups": [
            {
              "kind": "kicker",
              "lines": [
                "宮中元宵"
              ]
            },
            {
              "kind": "",
              "lines": [
                "明代，宮中正逢元宵。",
                "庭院裡張燈設戲，",
                "一場節慶，鋪展在長卷之中。"
              ]
            },
            {
              "kind": "closing",
              "lines": [
                "今夜，你也將走入畫裡。"
              ]
            }
          ]
        },
        {
          "label": "畫中元宵",
          "caption": "憲宗元宵行樂圖 · 中國國家博物館藏",
          "action": "聽候囑咐",
          "groups": [
            {
              "kind": "kicker",
              "lines": [
                "畫中元宵"
              ]
            },
            {
              "kind": "",
              "lines": [
                "《憲宗元宵行樂圖》，",
                "是明代的絹本設色長卷。",
                "作者姓名未詳，",
                "現藏中國國家博物館。"
              ]
            },
            {
              "kind": "closing",
              "lines": [
                "畫中以紅牆分隔庭院，",
                "留下宮中慶賞元宵的場景。"
              ]
            }
          ]
        },
        {
          "label": "初次隨行",
          "caption": "你的身份 · 初次隨行的小內侍",
          "action": "入畫尋人",
          "groups": [
            {
              "kind": "kicker",
              "lines": [
                "初次隨行"
              ]
            },
            {
              "kind": "",
              "lines": [
                "你是初次隨行入宮的小內侍。",
                "眼前的人與事，樣樣新鮮。"
              ]
            },
            {
              "kind": "quote",
              "lines": [
                "帶你的內侍低聲囑咐：",
                "「先認清陛下的眉眼與鬍鬚，",
                "待會兒，跟上他的身影。」"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "kangqu-listening",
      "title": "在人群中聽樂",
      "version": "2.2.0",
      "role": "初到京城的外鄉客",
      "fiction": "外鄉客身份及人物對白為遊戲虛構",
      "scenes": [
        {
          "label": "為誰祝壽",
          "caption": "清代 · 一七五一年萬壽慶典",
          "action": "看看這一卷",
          "groups": [
            {
              "kind": "kicker",
              "lines": [
                "為誰祝壽"
              ]
            },
            {
              "lines": [
                "清乾隆十六年，公元一七五一年。",
                "乾隆為母親崇慶皇太后，",
                "慶祝六十壽辰。"
              ]
            },
            {
              "kind": "closing",
              "lines": [
                "京城沿途張燈設戲，",
                "街道也成了慶典的場所。"
              ]
            }
          ]
        },
        {
          "label": "畫中一街",
          "caption": "康衢駢慶 · 萬壽圖第三卷",
          "action": "走進人群",
          "groups": [
            {
              "kind": "kicker",
              "lines": [
                "畫中一街"
              ]
            },
            {
              "lines": [
                "眼前的《康衢駢慶》，",
                "是皇太后六旬《萬壽圖》",
                "的第三卷。"
              ]
            },
            {
              "kind": "closing",
              "lines": [
                "張廷彥等宮廷畫家，",
                "把沿街的人群與慶典活動，",
                "留在這一卷裡。"
              ]
            }
          ]
        },
        {
          "label": "外鄉來客",
          "caption": "你的身份 · 初到京城的外鄉客",
          "action": "入畫尋找樂手",
          "groups": [
            {
              "kind": "kicker",
              "lines": [
                "外鄉來客"
              ]
            },
            {
              "lines": [
                "你初到京城，便遇上這場熱鬧。",
                "街旁彩飾連綿，人群間樂聲傳來。"
              ]
            },
            {
              "kind": "closing",
              "lines": [
                "這條街，怎樣為皇太后祝壽？",
                "先找一位樂手，從他那裡聽起。"
              ]
            }
          ]
        }
      ]
    }
  ]
}
