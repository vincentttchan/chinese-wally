    "alignment": [
      {
        "columns": [
          {
            "height": 383.140625,
            "text": "三國時，曹植寫下《洛神賦》，",
            "width": 44.3984375,
            "x": 881.8046875,
            "y": 140.796875
          },
          {
            "height": 301.0390625,
            "text": "描繪一場人與神的相遇。",
            "width": 44.3984375,
            "x": 793.8046875,
            "y": 140.796875
          },
          {
            "height": 273.671875,
            "text": "故事裡，他行經洛水，",
            "width": 44.3984375,
            "x": 705.8046875,
            "y": 140.796875
          },
          {
            "height": 355.7734375,
            "text": "在水岸之間，遇見神女洛神。",
            "width": 44.3984375,
            "x": 617.8046875,
            "y": 140.796875
          },
          {
            "height": 301.0390625,
            "text": "行旅的腳步，就此停留，",
            "width": 44.3984375,
            "x": 529.8046875,
            "y": 140.796875
          },
          {
            "height": 328.40625,
            "text": "目光所及，多了她的身影。",
            "width": 44.3984375,
            "x": 441.8046875,
            "y": 140.796875
          },
          {
            "height": 355.7734375,
            "text": "一段故事，從這片水岸展開。",
            "width": 44.3984375,
            "x": 353.8046875,
            "y": 140.796875
          }
        ],
        "stage": "引言第1幕，共三幕"
      },
      {
        "columns": [
          {
            "height": 301.0390625,
            "text": "眼前這卷《洛神賦圖》，",
            "width": 44.3984375,
            "x": 881.8046875,
            "y": 140.796875
          },
          {
            "height": 301.0390625,
            "text": "將賦中的故事繪成長卷。",
            "width": 44.3984375,
            "x": 793.8046875,
            "y": 140.796875
          },
          {
            "height": 273.671875,
            "text": "原本相傳為顧愷之作，",
            "width": 44.3984375,
            "x": 705.8046875,
            "y": 140.796875
          },
          {
            "height": 355.7734375,
            "text": "此卷是北京故宮所藏宋摹本。",
            "width": 44.3984375,
            "x": 617.8046875,
            "y": 140.796875
          },
          {
            "height": 355.7734375,
            "text": "山水之間，熟悉的身影再現，",
            "width": 44.3984375,
            "x": 529.8046875,
            "y": 140.796875
          },
          {
            "height": 328.40625,
            "text": "衣冠相似，姿態卻有不同。",
            "width": 44.3984375,
            "x": 441.8046875,
            "y": 140.796875
          },
          {
            "height": 328.40625,
            "text": "他們之間，又發生了甚麼？",
            "width": 44.3984375,
            "x": 353.8046875,
            "y": 140.796875
          }
        ],
        "stage": "引言第2幕，共三幕"
      },
      {
        "columns": [
          {
            "height": 328.40625,
            "text": "你是循賦入畫的年輕書生，",
            "width": 44.3984375,
            "x": 881.8046875,
            "y": 140.796875
          },
          {
            "height": 355.7734375,
            "text": "帶著《洛神賦》，展開此卷。",
            "width": 44.3984375,
            "x": 793.8046875,
            "y": 140.796875
          },
          {
            "height": 301.0390625,
            "text": "先認清岸上曹植的面貌，",
            "width": 44.3984375,
            "x": 705.8046875,
            "y": 140.796875
          },
          {
            "height": 328.40625,
            "text": "找到他，再細看他的衣袖。",
            "width": 44.3984375,
            "x": 617.8046875,
            "y": 140.796875
          },
          {
            "height": 355.7734375,
            "text": "循著身影，留意姿態與位置，",
            "width": 44.3984375,
            "x": 529.8046875,
            "y": 140.796875
          },
          {
            "height": 355.7734375,
            "text": "看過細節，再翻開相應賦文，",
            "width": 44.3984375,
            "x": 441.8046875,
            "y": 140.796875
          },
          {
            "height": 383.140625,
            "text": "讓文字與畫面，慢慢連在一起。",
            "width": 44.3984375,
            "x": 353.8046875,
            "y": 140.796875
          }
        ],
        "stage": "引言第3幕，共三幕"
      }
    ],
